# Configuración pública; nunca utilices service_role ni sb_secret_… aquí.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidad con proyectos con clave anon heredada:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# npm run build:preview también acepta SUPABASE_URL y SUPABASE_PUBLISHABLE_KEY.
# Google se mantiene desactivado en la preliminar salvo habilitación explícita:
GOOGLE_AUTH_ENABLED=false
